# Supabase — projeto compartilhado com o Clinic Control e o DashBoard-s.
# A URL do projeto fica de fora de propósito: preencher com a do ambiente, para
# o exemplo não amarrar o repositório a um projeto específico.
#
# Sem `NEXT_PUBLIC_`: o prefixo congela o valor no build (ver src/shared/db.ts).
# Não há anon key — o browser nunca fala com o Supabase, só o servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# As credenciais de cada clínica (prontuário e mensageria) NÃO ficam aqui —
# ficam na tabela aniversariantes_clinicas, cadastradas pela área de setup
# (/setup, ver SETUP_PASSWORD_HASH abaixo).
# As variáveis acima servem só para alcançar o banco.
#
# O schema é `aniversariantes`, fixo. Não há env var de schema: ela existia no
# app anterior só para viabilizar a janela de migração de `public`, que já
# fechou. Ver docs/adr/0002-banco-compartilhado.md.

# Segredo que assina os links de acesso ao painel. O app NÃO tem login: o acesso
# é por link assinado, e o token carrega a clínica — é isso que impede um acesso
# de ler dado de outra. Sem esta variável o app rejeita TODO acesso (falha
# fechado, de propósito).
# A área de setup também emite links com ele. Se o Clinic Control emitir links
# para o painel, precisa ter o MESMO valor.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotacionar invalida todos os links já colados nas abas da plataforma.
LINK_SECRET=

# Hosts do white label autorizados a informar a clínica pela URL (?clinica=).
# Lista separada por vírgula; subdomínios contam. Default: app.fluxodonto.com
#
# Usado em dois lugares: o proxy aceita o company_id quando o Referer é de um
# destes hosts, e o next.config.ts monta o `frame-ancestors` da CSP a partir da
# mesma lista — quem pode embutir é quem pode informar a clínica.
EMBED_HOSTS=

# Segredo que autentica as rotas de cron (sincronização Clinicorp e
# reconciliação de status). Quem chama manda `Authorization: Bearer <valor>` —
# na VPS, o crontab do servidor (ver docs/deploy-vps.md). Sem ele as rotas
# rejeitam qualquer chamada. Cadastrar no ambiente do serviço; o .env.local não
# vale em produção.
CRON_SECRET=

# Hash da senha da ÁREA DE SETUP (/setup) — onde a equipe cadastra clínicas e
# credenciais de integração. Não é a senha: é o hash dela. Gerar com
#   npm run setup:senha
# (a senha é digitada no terminal e não sai da máquina). Sem esta variável a
# área de setup responde 503 e o painel das clínicas segue funcionando.
# Trocar o hash derruba todas as sessões abertas do setup.
SETUP_PASSWORD_HASH=
